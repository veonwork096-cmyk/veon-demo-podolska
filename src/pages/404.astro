---
// Service 404 page (R-205): leads back to the sections of the homepage.
import Base from "../layouts/Base.astro";
import logo from "../assets/img/podolska-logo.svg";
import Icon from "../components/Icon.astro";
import { contacts, nav } from "../data/clinic";
---
<Base lang="uk" title="Сторінку не знайдено — Dr. Podolska" description="Такої сторінки немає. Перейдіть на головну Dr. Podolska або зателефонуйте на рецепцію." rec="R-205">
  <header slot="header" class="site-header">
    <div class="container site-header__inner">
      <a class="logo" href={import.meta.env.BASE_URL}><img src={logo.src} width="132" height="32" alt="Dr. Podolska, головна сторінка" /></a>
      <a class="btn btn--primary" href={contacts.reception.href}><Icon name="phone" />Подзвонити</a>
    </div>
  </header>
  <section class="section notfound" aria-labelledby="nf-title">
    <div class="container notfound__inner">
      <h1 id="nf-title">Такої сторінки немає</h1>
      <p class="section__intro">Можливо, адреса змінилася. Ось розділи головної сторінки:</p>
      <ul class="notfound__links">
        <li><a class="text-link" href={import.meta.env.BASE_URL}>Головна</a></li>
        {nav.map((n) => <li><a class="text-link" href={`/${n.href}`}>{n.label}</a></li>)}
      </ul>
      <p>Запис і питання: <a class="text-link" href={contacts.reception.href}>{contacts.reception.display}</a></p>
    </div>
  </section>
</Base>
