---
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import { contacts } from "../data/clinic";
---
<Section id="kontakty" rec="R-101,R-102" class="section contacts">
  <div class="container contacts__grid">
    <div class="contacts__place">
      <h2>Як нас знайти</h2>
      <p class="contacts__address">
        <span class="contacts__city">{contacts.address.city}, вулиця</span>
        <span class="contacts__street">{contacts.address.short}</span>
      </p>
      <a class="btn btn--secondary" href={contacts.map} rel="noopener" target="_blank"><Icon name="route" />Прокласти маршрут<span class="visually-hidden"> (Google Maps, нова вкладка)</span></a>
    </div>
    <div class="contacts__info">
      <div class="contacts__block">
        <h3 class="contacts__label">Години роботи</h3>
        <dl class="hours">
          {contacts.hours.map((h) => (
            <div class="hours__row"><dt>{h.full}</dt><dd>{h.time}</dd></div>
          ))}
        </dl>
      </div>
      <div class="contacts__block">
        <h3 class="contacts__label">Телефони</h3>
        <ul class="phones">
          <li>
            <a class="phones__num" href={contacts.reception.href}>{contacts.reception.display}</a>
            <span class="text-muted">Рецепція, запис на прийом</span>
          </li>
          <li>
            <a class="phones__num" href={contacts.messengers.tel}>{contacts.messengers.display}</a>
            <span class="text-muted">Viber, Telegram, Messenger</span>
            <a class="text-link" href={contacts.messengers.viber}><Icon name="chat" size={18} />Написати у Viber</a>
          </li>
        </ul>
      </div>
      <div class="contacts__block">
        <h3 class="contacts__label">Оплата</h3>
        <p>Visa, Mastercard, Apple Pay, Google Pay</p>
      </div>
    </div>
  </div>
</Section>
