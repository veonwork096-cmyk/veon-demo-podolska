---
import logo from "../assets/img/podolska-logo.svg";
import Icon from "./Icon.astro";
import { contacts, nav } from "../data/clinic";
---
<header class="site-header" data-rec="R-101,R-209,GA-R001,MA-R003">
  <div class="container site-header__inner">
    <a class="logo" href="#top">
      <img src={logo.src} width="132" height="32" alt="Dr. Podolska, на початок сторінки" />
    </a>
    <nav class="nav-main" aria-label="Розділи сторінки">
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>
    <div class="site-header__actions">
      <a class="header-phone" href={contacts.reception.href}>{contacts.reception.display}</a>
      <a class="btn btn--primary header-cta" href={contacts.reception.href}>Записатися</a>
      <a class="icon-btn header-call" href={contacts.reception.href}>
        <Icon name="phone" />
        <span class="visually-hidden">Подзвонити на рецепцію</span>
      </a>
      <details class="menu" data-menu>
        <summary class="icon-btn menu__toggle">
          <span class="menu__icon menu__icon--open"><Icon name="menu" /></span>
          <span class="menu__icon menu__icon--close"><Icon name="close" /></span>
          <span class="visually-hidden">Меню</span>
        </summary>
        <div class="menu__panel">
          <nav aria-label="Меню">
            <ul class="menu__list">
              {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
            </ul>
          </nav>
          <div class="menu__contacts">
            <p class="menu__phones"><a href={contacts.reception.href}>{contacts.reception.display}</a> рецепція<br /><a href={contacts.messengers.tel}>{contacts.messengers.display}</a> Viber, Telegram, Messenger</p>
            <a class="btn btn--primary" href={contacts.reception.href}>
              <Icon name="phone" />Подзвонити
            </a>
            <a class="btn btn--secondary" href={contacts.messengers.viber}>
              <Icon name="chat" />Viber
            </a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
