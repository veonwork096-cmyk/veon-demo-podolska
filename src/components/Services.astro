---
import Section from "./Section.astro";
import Portrait from "./Portrait.astro";
import FutureLink from "./FutureLink.astro";
import Icon from "./Icon.astro";
import { directions, contacts, FUTURE } from "../data/clinic";
---
<Section id="poslugy" rec="R-103,R-105" class="section services">
  <div class="container">
    <div class="section__head">
      <h2>З чим ви звертаєтесь</h2>
      <p class="section__intro">Ціна прийому та лікарі напряму одразу в картці.</p>
    </div>
    <div class="mosaic">
      {directions.map((d, i) => (
        <article class:list={["tile", `tile--${d.size}`, { "tile--plain": d.plain }]} data-reveal style={`--reveal-delay:${i * 60}ms`} aria-labelledby={`dir-${d.id}`}>
          <div class="tile__head">
            <h3 class="tile__title" id={`dir-${d.id}`}>{d.title}</h3>
            <p class="tile__price">
              {d.price && <span class="price">{d.price}</span>}
              {d.priceNote && <span class="tile__price-note">{d.priceNote}</span>}
            </p>
          </div>
          <p class="tile__text">{d.text}</p>
          {d.people.length > 0 && (
            <ul class="tile__faces" aria-label="Лікарі напряму">
              {d.people.map((p) => <li><Portrait person={p} size="xs" showRole={false} /></li>)}
            </ul>
          )}
          <div class="tile__actions">
            <a class="text-link" href={contacts.reception.href}><Icon name="phone" size={18} />Подзвонити</a>
            <FutureLink note={FUTURE}>Детальніше про напрям</FutureLink>
          </div>
        </article>
      ))}
    </div>
  </div>
</Section>
